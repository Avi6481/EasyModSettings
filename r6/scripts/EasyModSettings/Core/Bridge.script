public class EasyMSBridge {
  public static function Protocol() -> String {
    return "EASYMS1";
  }

  public static function Slot() -> BlackboardID_Variant {
    return GetAllBlackboardDefs().UIGameData.UIjailbreakData;
  }

  public static function Head(game: GameInstance) -> GenericNotificationBaseAction {
    let board: IBlackboard = GameInstance.GetBlackboardSystem(game).Get(GetAllBlackboardDefs().UIGameData);
    if (!board) {
      return NULL;
    }
    return board.GetVariant(EasyMSBridge.Slot()) as GenericNotificationBaseAction;
  }

  public static function Send(owner: wref<GameObject>, message: String) -> String {
    if (!owner) {
      return "";
    }
    let game: GameInstance = owner.GetGame();
    let head: GenericNotificationBaseAction = EasyMSBridge.Head(game);
    if (!head) {
      return "";
    }
    let msg: ListItemData = new ListItemData;
    msg.label = EasyMSBridge.Protocol() + "|" + message;
    let handled: Bool = head.Execute(msg);
    if (!handled) {
      return msg.label;
    }
    return msg.label;
  }

  public static function Answered(reply: String) -> Bool {
    return StrFindFirst(reply, "\n@@") >= 0;
  }

  public static function Answer(reply: String) -> String {
    if (!EasyMSBridge.Answered(reply)) {
      return "";
    }
    let text: String = StrAfterFirst(reply, "\n@@");
    let cut: Int32 = StrFindFirst(text, "\n");
    if (cut >= 0) {
      text = StrLeft(text, cut);
    }
    return text;
  }

  public static function Ask(owner: wref<GameObject>, command: String, optionId: CName) -> String {
    return EasyMSBridge.Answer(EasyMSBridge.Send(owner, command + "|" + NameToString(optionId)));
  }

  public static function Encode(option: EasyMSOption) -> String {
    if (option.kind == EasyMSKind.Toggle()) {
      if (option.on) {
        return "1";
      }
      return "0";
    }
    if (option.kind == EasyMSKind.Slider()) {
      return FloatToString(option.value);
    }
    return IntToString(option.choice);
  }

  public static function Decode(option: EasyMSOption, text: String) -> Void {
    if (StrLen(text) == 0) {
      return;
    }
    if (option.kind == EasyMSKind.Toggle()) {
      option.on = StrCmp(text, "1") == 0;
      return;
    }
    if (option.kind == EasyMSKind.Slider()) {
      option.value = ClampF(StringToFloat(text, option.defValue), option.minValue, option.maxValue);
      return;
    }
    if (option.kind == EasyMSKind.Choice()) {
      option.choice = Clamp(StringToInt(text, option.defChoice), 0, Max(0, option.choices.Size() - 1));
    }
  }

  private static function Field(parts: array<String>, index: Int32) -> String {
    if (index >= parts.Size()) {
      return "";
    }
    let value: String = parts[index];
    if (StrCmp(value, "-") == 0) {
      return "";
    }
    return value;
  }

  private static function Name(parts: array<String>, index: Int32) -> CName {
    let value: String = EasyMSBridge.Field(parts, index);
    if (StrLen(value) == 0) {
      return n"None";
    }
    return StringToName(value);
  }

  private static function Number(parts: array<String>, index: Int32) -> Float {
    return StringToFloat(EasyMSBridge.Field(parts, index), 0.0);
  }

  public static function Parse(reply: String) -> array<EasyMSMod> {
    let mods: array<EasyMSMod>;
    let lines: array<String> = StrSplit(reply, "\n");
    let mod: EasyMSMod;
    let page: EasyMSPage;
    let i: Int32 = 0;
    while (i < lines.Size()) {
      let parts: array<String> = StrSplit(lines[i], "|");
      if (parts.Size() >= 2) {
        let kind: String = parts[0];
        if (StrCmp(kind, "mod") == 0) {
          mod = EasyMSBridge.NewMod(parts);
          page = mod.root;
          mods.PushBack(mod);
        } else {
          if (mod) {
            if (StrCmp(kind, "page") == 0) {
              page = EasyMSBridge.PageFor(mod, EasyMSBridge.Field(parts, 1), EasyMSBridge.Field(parts, 2));
            } else {
              EasyMSBridge.AddRow(page, kind, parts);
            }
          }
        }
      }
      i += 1;
    }
    let m: Int32 = 0;
    while (m < mods.Size()) {
      EasyMSBridge.LinkSubmenus(mods[m]);
      m += 1;
    }
    return mods;
  }

  private static function NewMod(parts: array<String>) -> EasyMSMod {
    let mod: EasyMSMod = new EasyMSMod;
    mod.remote = true;
    mod.root = mod.NewPage("");
    mod.pageKeys.PushBack("root");
    mod.Describe(EasyMSBridge.Name(parts, 1), EasyMSBridge.Field(parts, 2), EasyMSBridge.Field(parts, 3), EasyMSBridge.Field(parts, 4), EasyMSBridge.Field(parts, 5));
    return mod;
  }

  private static function PageFor(mod: EasyMSMod, key: String, title: String) -> EasyMSPage {
    let i: Int32 = 0;
    while (i < mod.pageKeys.Size()) {
      if (StrCmp(mod.pageKeys[i], key) == 0) {
        if (StrLen(title) > 0) {
          mod.pages[i].title = title;
        }
        return mod.pages[i];
      }
      i += 1;
    }
    let page: EasyMSPage = mod.NewPage(title);
    mod.pageKeys.PushBack(key);
    return page;
  }

  private static function LinkSubmenus(mod: EasyMSMod) -> Void {
    let p: Int32 = 0;
    while (p < mod.pages.Size()) {
      let options: array<EasyMSOption> = mod.pages[p].options;
      let o: Int32 = 0;
      while (o < options.Size()) {
        if (options[o].kind == EasyMSKind.Submenu() && StrLen(options[o].pageKey) > 0) {
          options[o].page = EasyMSBridge.PageFor(mod, options[o].pageKey, "");
          if (StrLen(options[o].page.title) == 0) {
            options[o].page.title = options[o].label;
          }
        }
        o += 1;
      }
      p += 1;
    }
  }

  private static function AddRow(page: EasyMSPage, kind: String, parts: array<String>) -> Void {
    let f1: String = EasyMSBridge.Field(parts, 1);
    let f2: String = EasyMSBridge.Field(parts, 2);
    let f3: String = EasyMSBridge.Field(parts, 3);
    if (StrCmp(kind, "header") == 0) {
      page.Header(f1);
      return;
    }
    if (StrCmp(kind, "note") == 0) {
      page.Note(f1);
      return;
    }
    if (StrCmp(kind, "toggle") == 0) {
      page.Toggle(StringToName(f1), f2, f3, StrCmp(EasyMSBridge.Field(parts, 4), "1") == 0);
      page.DependsOn(EasyMSBridge.Name(parts, 5));
      return;
    }
    if (StrCmp(kind, "slider") == 0) {
      page.Slider(StringToName(f1), f2, f3, EasyMSBridge.Number(parts, 4), EasyMSBridge.Number(parts, 5), EasyMSBridge.Number(parts, 6), EasyMSBridge.Number(parts, 7), StringToInt(EasyMSBridge.Field(parts, 8), 0), EasyMSBridge.Field(parts, 9));
      page.DependsOn(EasyMSBridge.Name(parts, 10));
      return;
    }
    if (StrCmp(kind, "choice") == 0) {
      page.Choice(StringToName(f1), f2, f3, StrReplaceAll(EasyMSBridge.Field(parts, 4), ";", "|"), StringToInt(EasyMSBridge.Field(parts, 5), 0));
      page.DependsOn(EasyMSBridge.Name(parts, 6));
      return;
    }
    if (StrCmp(kind, "button") == 0) {
      page.Button(StringToName(f1), f2, f3, EasyMSBridge.Field(parts, 4));
      page.DependsOn(EasyMSBridge.Name(parts, 5));
      return;
    }
    if (StrCmp(kind, "confirm") == 0) {
      page.Confirm(StringToName(f1), f2, f3);
      page.DependsOn(EasyMSBridge.Name(parts, 4));
      return;
    }
    if (StrCmp(kind, "reset") == 0) {
      page.ResetAll(StringToName(f1), f2, f3);
      return;
    }
    if (StrCmp(kind, "submenu") == 0) {
      page.Submenu(f2, f3, NULL);
      page.SetPageKey(f1);
      page.DependsOn(EasyMSBridge.Name(parts, 4));
      return;
    }
    if (StrCmp(kind, "info") == 0) {
      page.Info(StringToName(f1), f2, f3);
    }
  }
}
